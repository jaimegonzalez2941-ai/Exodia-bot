# Copy this file to `.env` and fill in the values before running the bot

# Discord Bot Token
TOKEN=your_discord_bot_token_here

# Channel ID where the public recruitment panel will be posted (optional)
TRIAL_SUBMISSION_CHANNEL_ID=1453958265015636058

# Channel ID where staff scouting dockets will be sent (optional)
STAFF_DOCKET_CHANNEL_ID=

# Optional: set NODE_ENV when running in production
NODE_ENV=development
